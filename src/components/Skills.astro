---
const categories = [
  {
    key: 'SPRACHEN',
    items: [
      { name: 'C++', icon: 'devicon-cplusplus-plain', level: 'FORTGESCHRITTEN' },
      { name: 'TypeScript', icon: 'devicon-typescript-plain', level: 'SICHER' },
      { name: 'Python', icon: 'devicon-python-plain', level: 'SICHER' },
      { name: 'JavaScript', icon: 'devicon-javascript-plain', level: 'SICHER' },
      { name: 'HTML / CSS', icon: 'devicon-html5-plain', level: 'SICHER' },
    ],
  },
  {
    key: 'FRONTEND',
    items: [
      { name: 'React 18', icon: 'devicon-react-original', level: 'SICHER' },
      { name: 'Tailwind CSS', icon: 'devicon-tailwindcss-plain', level: 'SICHER' },
      { name: 'Vite', icon: 'devicon-vitejs-plain', level: 'SICHER' },
    ],
  },
  {
    key: 'BACKEND / DB',
    items: [
      { name: 'Flask', icon: 'devicon-flask-original', level: 'SICHER' },
      { name: 'MongoDB', icon: 'devicon-mongodb-plain', level: 'SICHER' },
      { name: 'REST APIs', icon: 'devicon-fastapi-plain', level: 'SICHER' },
    ],
  },
  {
    key: 'DEVOPS / SYS',
    items: [
      { name: 'Docker', icon: 'devicon-docker-plain', level: 'SICHER' },
      { name: 'Linux', icon: 'devicon-linux-plain', level: 'SICHER' },
      { name: 'Git', icon: 'devicon-git-plain', level: 'SICHER' },
      { name: 'Fish Shell', icon: 'devicon-bash-plain', level: 'GRUNDLAGEN' },
    ],
  },
];
---

<section id="skills" class="dots-dark">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-24">

    <div class="reveal mb-16 border-b-2 border-cream/10 pb-6">
      <p class="font-mono text-xs text-cream/30 uppercase tracking-widest mb-3">TECH_STACK //</p>
      <h2 class="display-italic text-cream" style="font-size: clamp(2.5rem, 7vw, 5.5rem);">
        SKILLS.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-x-16 gap-y-12">
      {categories.map((cat, i) => (
        <div class={`reveal reveal-delay-${i + 1}`}>
          <p class="font-mono text-xs text-cream/30 uppercase tracking-widest mb-5 pb-3 border-b border-cream/10">
            {cat.key}
          </p>
          <div class="space-y-0">
            {cat.items.map((item) => (
              <div class="flex items-center gap-4 py-3 border-b border-cream/5 group hover:border-cream/20 transition-colors">
                <i class={`${item.icon} text-xl text-cream/30 group-hover:text-cream transition-colors shrink-0`}></i>
                <span class="font-mono text-xs text-cream/60 flex-1 group-hover:text-cream transition-colors uppercase tracking-wide">
                  {item.name}
                </span>
                <span class={`font-mono text-xs tracking-widest ${
                  item.level === 'FORTGESCHRITTEN' ? 'text-red' :
                  item.level === 'SICHER' ? 'text-cream/30' :
                  'text-cream/15'
                }`}>
                  {item.level}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    

  </div>
</section>
