---
const projects = [
  {
    number: '01',
    title: 'Fitnesstracker',
    description:
      'Fullstack-Webanwendung zur Erfassung und Auswertung von Trainingseinheiten. Entwickelt im Rahmen des Studiums — vollständiger Zyklus von Konzeption bis Deployment.',
    stack: ['React 18', 'TypeScript', 'Tailwind CSS', 'Flask', 'MongoDB'],
    highlights: [
      'Typsichere Komponenten mit React + TypeScript',
      'REST-API mit Flask, NoSQL-Datenhaltung in MongoDB',
      'Vollständiger Entwicklungszyklus: Design → Build → Deploy',
    ],
    github: '#',
    demo: null,
    wip: true,
  },
  {
    number: '02',
    title: 'Mitarbeiterzeiterfassung',
    description:
      'Web-Anwendung zur Protokollierung von Mitarbeiterzeiten. Bewusster Verzicht auf React: reines Tailwind CSS für eine schlanke, wartbare UI ohne Framework-Overhead.',
    stack: ['Tailwind CSS', 'JavaScript', 'Flask', 'MongoDB'],
    highlights: [
      'Bewusste Entscheidung gegen React-Overhead',
      'Schlanke UI mit Tailwind ohne Build-Komplexität',
      'REST-Backend mit Flask',
    ],
    github: '#',
    demo: null,
    wip: true,
  },
  {
    number: '03',
    title: 'Home-Server Setup',
    description:
      'Self-Hosted Infrastructure auf einem Ubuntu 24.04 Server: Pi-hole für DNS-Adblocking, NAS für lokale Datenhaltung, alles containerisiert mit Docker.',
    stack: ['Docker', 'Linux', 'Pi-hole', 'Ubuntu 24.04'],
    highlights: [
      'Docker-Stack für alle Dienste',
      'Pi-hole: DNS-Server + Netzwerk-Adblocking',
      'NAS-Setup für lokale Datenhaltung',
    ],
    github: '#',
    demo: null,
    wip: false,
  },
];
---

<section id="projects" class="py-24 px-6 max-w-5xl mx-auto">
  <div class="reveal">
    <p class="section-label">03 / Projekte</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12">
      Was ich gebaut habe
    </h2>
  </div>

  <div class="space-y-6">
    {projects.map((project, i) => (
      <article class={`reveal reveal-delay-${i + 1} group border border-border hover:border-accent/30 transition-all duration-300 p-6 md:p-8 bg-surface/30 hover:bg-surface/60`}>
        <div class="flex items-start justify-between gap-4 mb-5">
          <div class="flex items-start gap-4">
            <span class="font-mono text-xs text-muted mt-1.5 shrink-0">{project.number}</span>
            <div>
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-semibold text-text group-hover:text-accent transition-colors duration-200">
                  {project.title}
                </h3>
                {project.wip && (
                  <span class="text-xs font-mono px-2 py-0.5 border border-yellow-500/30 text-yellow-500/70">
                    WIP
                  </span>
                )}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener"
                class="text-muted hover:text-accent transition-colors duration-200"
                aria-label="GitHub"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </a>
            )}
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener"
                class="text-muted hover:text-accent transition-colors duration-200"
                aria-label="Live Demo"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M6 2H2v12h12v-4M10 2h4v4M14 2L7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
          </div>
        </div>

        <p class="text-text/60 text-sm leading-relaxed mb-5 ml-8">
          {project.description}
        </p>

        <div class="ml-8 mb-5 space-y-1.5">
          {project.highlights.map((h) => (
            <p class="text-xs text-muted flex items-start gap-2">
              <span class="text-accent/60 mt-0.5 shrink-0">›</span>
              {h}
            </p>
          ))}
        </div>

        <div class="ml-8 flex flex-wrap gap-2">
          {project.stack.map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
