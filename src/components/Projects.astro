---
const projects = [
  {
    number: '01',
    title: 'FITNESSTRACKER',
    category: 'FULLSTACK WEB APP',
    description:
      'Webanwendung zur Erfassung und Auswertung von Trainingseinheiten. Vollständiger Entwicklungszyklus von der Konzeption bis zum Deployment — typsichere Komponenten, REST-API und NoSQL-Datenhaltung.',
    stack: ['REACT 18', 'TYPESCRIPT', 'TAILWIND', 'FLASK', 'MONGODB'],
    github: '#',
    wip: true,
  },
  {
    number: '02',
    title: 'ZEITERFASSUNG',
    category: 'FULLSTACK WEB APP',
    description:
      'Mitarbeiterzeiterfassung ohne Framework-Overhead. Bewusste Entscheidung gegen React: reines Tailwind CSS für eine schlanke, wartbare UI — zeigt dass Toolwahl Kontext braucht.',
    stack: ['TAILWIND', 'JAVASCRIPT', 'FLASK', 'MONGODB'],
    github: '#',
    wip: true,
  },
  {
    number: '03',
    title: 'HOME SERVER',
    category: 'DEVOPS // SELF-HOSTING',
    description:
      'Self-Hosted Infrastructure auf Ubuntu 24.04: Pi-hole für DNS-Adblocking, NAS für lokale Datenhaltung, alles containerisiert mit Docker. Eigeninitiative außerhalb der Uni.',
    stack: ['DOCKER', 'LINUX', 'PI-HOLE', 'UBUNTU'],
    github: '#',
    wip: false,
  },
];
---

<section id="projects" class="dots-dark">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-24">

    <div class="reveal flex items-end justify-between mb-16 border-b-2 border-cream/10 pb-6">
      <div>
        <p class="font-mono text-xs text-cream/30 uppercase tracking-widest mb-3">CORE_FOCUS //</p>
        <h2 class="display-italic text-cream" style="font-size: clamp(2.5rem, 7vw, 5.5rem);">
          SELECTED<br />WORK.
        </h2>
      </div>
      <span class="font-mono text-xs text-cream/20 tracking-widest hidden md:block">
        {projects.length} PROJECTS
      </span>
    </div>

    <div class="space-y-0">
      {projects.map((p, i) => (
        <article class={`reveal reveal-delay-${i + 1} grid md:grid-cols-2 gap-8 py-14 border-b-2 border-cream/10 group`}>

          <!-- Left: text -->
          <div class="flex flex-col justify-between">
            <div>
              <!-- Project label box -->
              <div class="mb-5 flex items-center gap-3">
                <span class="label-tag text-dark bg-cream border-cream text-xs">
                  PROJECT_{p.number}
                </span>
                {p.wip && (
                  <span class="label-tag text-red border-red text-xs">WIP</span>
                )}
              </div>

              <!-- Title -->
              <h3 class="display-italic text-cream mb-3 group-hover:text-red transition-colors duration-200"
                  style="font-size: clamp(2rem, 5vw, 3.5rem);">
                {p.title}
              </h3>

              <!-- Category -->
              <p class="font-mono text-xs text-cream/30 uppercase tracking-widest mb-5">{p.category}</p>

              <!-- Description with left accent bar -->
              <div class="flex gap-4 mb-6">
                <div class="w-0.5 bg-red shrink-0 mt-1"></div>
                <p class="font-mono text-xs text-cream/50 leading-relaxed">{p.description}</p>
              </div>
            </div>

            <!-- Tags + link -->
            <div class="flex flex-wrap gap-2 items-center">
              {p.stack.map((tech) => (
                <span class="tech-pill text-cream/40 border-cream/20">{tech}</span>
              ))}
              <a
                href={p.github}
                target="_blank"
                rel="noopener"
                class="ml-auto font-mono text-xs text-red hover:text-cream transition-colors uppercase tracking-widest"
              >
                OPEN_GITHUB →
              </a>
            </div>
          </div>

          <!-- Right: screenshot placeholder -->
          <div class="hidden md:flex items-center justify-center">
            <div class="border-2 border-cream/15 w-full aspect-video flex items-center justify-center group-hover:border-cream/30 transition-colors duration-300">
              <span class="font-mono text-xs text-cream/15 uppercase tracking-widest">
                SCREENSHOT // COMING SOON
              </span>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
