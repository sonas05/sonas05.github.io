---
---

<section id="education" class="py-24 px-6 max-w-5xl mx-auto">
  <div class="reveal">
    <p class="section-label">04 / Werdegang</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12">
      Ausbildung & Erfahrung
    </h2>
  </div>

  <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
    <div class="reveal reveal-delay-1">
      <h3 class="text-xs font-mono tracking-widest text-muted uppercase mb-6 pb-3 border-b border-border">
        Ausbildung
      </h3>
      <div class="space-y-6">
        <div class="relative pl-5 border-l border-border hover:border-accent/40 transition-colors duration-300">
          <p class="text-sm font-semibold text-text mb-1">Duales Studium Informatik</p>
          <p class="text-xs font-mono text-accent mb-2">Oktober 2024 – heute · 4. Semester</p>
          <ul class="text-xs text-muted space-y-1">
            <li>› Schwerpunkt: Internet- & Webtechnologien</li>
            <li>› Grundlagen bis moderne Frameworks</li>
            <li>› Parallele Praxisphasen im Unternehmen</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="reveal reveal-delay-2">
      <h3 class="text-xs font-mono tracking-widest text-muted uppercase mb-6 pb-3 border-b border-border">
        Erfahrung
      </h3>
      <div class="space-y-6">
        <div class="relative pl-5 border-l border-border hover:border-accent/40 transition-colors duration-300">
          <p class="text-sm font-semibold text-text mb-1">Praxispartner (Duales Studium)</p>
          <p class="text-xs font-mono text-accent mb-2">Oktober 2024 – heute</p>
          <ul class="text-xs text-muted space-y-1">
            <li>› Softwareentwicklung im professionellen Umfeld</li>
            <li>› Praktische Anwendung von Studieninhalten</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="reveal reveal-delay-3 md:col-span-2">
      <h3 class="text-xs font-mono tracking-widest text-muted uppercase mb-6 pb-3 border-b border-border">
        Zertifikate & Weiterbildung
      </h3>
      <div class="grid sm:grid-cols-2 gap-3">
        <div class="p-4 border border-border bg-surface/30 opacity-50">
          <p class="text-sm text-text mb-1">Cybersecurity Zertifikate</p>
          <p class="text-xs text-muted font-mono">Geplant · In Vorbereitung</p>
        </div>
        <div class="p-4 border border-border bg-surface/30">
          <p class="text-sm text-text mb-1">Self-Directed Learning</p>
          <p class="text-xs text-muted font-mono">TryHackMe · HackTheBox · laufend</p>
        </div>
      </div>
    </div>
  </div>
</section>
