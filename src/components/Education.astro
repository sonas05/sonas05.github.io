---
---

<section id="education" class="dots-light">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-24">

    <div class="reveal mb-16 border-b-2 border-dark/10 pb-6">
      <p class="font-mono text-xs text-dark/30 uppercase tracking-widest mb-3">WERDEGANG //</p>
      <h2 class="display-italic text-dark" style="font-size: clamp(2.5rem, 7vw, 5.5rem);">
        EDUCATION<br />&amp; XP.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-x-10 gap-y-10">

      <!-- Ausbildung -->
      <div class="reveal reveal-delay-1">
        <p class="font-mono text-xs text-dark/30 uppercase tracking-widest mb-6 pb-3 border-b-2 border-dark/10">
          AUSBILDUNG
        </p>
        <div class="pl-4 border-l-2 border-dark">
          <p class="font-mono text-xs text-dark uppercase tracking-wide font-bold mb-1">
            Duales Studium Informatik
          </p>
          <p class="font-mono text-xs text-red uppercase tracking-widest mb-3">2023 – HEUTE · 4. SEM.</p>
          <ul class="space-y-1">
            {['Schwerpunkt: Internet- & Webtechnologien', 'Parallele Praxisphasen im Unternehmen', 'Grundlagen bis moderne Frameworks'].map(item => (
              <li class="font-mono text-xs text-dark/50">› {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Erfahrung -->
      <div class="reveal reveal-delay-2">
        <p class="font-mono text-xs text-dark/30 uppercase tracking-widest mb-6 pb-3 border-b-2 border-dark/10">
          ERFAHRUNG
        </p>
        <div class="pl-4 border-l-2 border-dark">
          <p class="font-mono text-xs text-dark uppercase tracking-wide font-bold mb-1">
            Praxispartner
          </p>
          <p class="font-mono text-xs text-red uppercase tracking-widest mb-3">2023 – HEUTE</p>
          <ul class="space-y-1">
            {['Softwareentwicklung im professionellen Umfeld', 'Praktische Anwendung von Studieninhalten', 'Teamarbeit und Projektarbeit'].map(item => (
              <li class="font-mono text-xs text-dark/50">› {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Zertifikate -->
      <div class="reveal reveal-delay-3">
        <p class="font-mono text-xs text-dark/30 uppercase tracking-widest mb-6 pb-3 border-b-2 border-dark/10">
          ZERTIFIKATE
        </p>
        <div class="space-y-4">
          <div class="pl-4 border-l-2 border-dark/20">
            <p class="font-mono text-xs text-dark/40 uppercase tracking-wide font-bold mb-1">
              Cybersecurity Certs
            </p>
            <p class="font-mono text-xs text-dark/30 uppercase tracking-widest">GEPLANT · IN VORBEREITUNG</p>
          </div>
          <div class="pl-4 border-l-2 border-dark">
            <p class="font-mono text-xs text-dark uppercase tracking-wide font-bold mb-1">
              Self-Directed Learning
            </p>
            <p class="font-mono text-xs text-red uppercase tracking-widest">TRYHACKME · HACKTHEBOX</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
