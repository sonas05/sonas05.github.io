---
const roadmap = [
  { status: 'DONE',   label: 'Duales Studium Informatik',           sub: 'seit Okt 2024' },
  { status: 'DONE',   label: 'TryHackMe / HackTheBox',              sub: 'selbstgesteuert · laufend' },
  { status: 'ACTIVE', label: 'Anthropic Claude Certified Architect', sub: 'AI Engineering · Anthropic' },
  { status: 'NEXT',   label: 'OWASP LLM Top 10 & AI Red Teaming',   sub: 'Prompt Injection · Model Security' },
  { status: 'TODO',   label: 'CompTIA Security+',                   sub: 'Foundational Security Cert' },
  { status: 'TODO',   label: 'eJPT',                                sub: 'Entry-Level Penetration Tester' },
  { status: 'TODO',   label: 'AI Security Engineer',                sub: 'Langfristziel' },
];
---

<section id="education" class="py-24 px-6 max-w-5xl mx-auto">
  <div class="reveal">
    <p class="font-mono text-xs text-cream/40 uppercase tracking-widest mb-3">04 / Werdegang</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12 text-cream">
      Ausbildung & Erfahrung
    </h2>
  </div>

  <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
    <div class="reveal reveal-delay-1">
      <h3 class="text-xs font-mono tracking-widest text-cream/40 uppercase mb-6 pb-3 border-b border-cream/10">
        Ausbildung
      </h3>
      <div class="space-y-6">
        <div class="relative pl-5 border-l border-cream/20 hover:border-red/40 transition-colors duration-300">
          <p class="text-sm font-semibold text-cream mb-1">Duales Studium Informatik</p>
          <p class="text-xs font-mono text-red mb-2">Oktober 2024 – heute · 4. Semester</p>
          <ul class="text-xs text-cream/50 space-y-1">
            <li>› Schwerpunkt: Internet- & Webtechnologien</li>
            <li>› Grundlagen bis moderne Frameworks</li>
            <li>› Parallele Praxisphasen im Unternehmen</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="reveal reveal-delay-2">
      <h3 class="text-xs font-mono tracking-widest text-cream/40 uppercase mb-6 pb-3 border-b border-cream/10">
        Erfahrung
      </h3>
      <div class="space-y-6">
        <div class="relative pl-5 border-l border-cream/20 hover:border-red/40 transition-colors duration-300">
          <p class="text-sm font-semibold text-cream mb-1">Praxispartner (Duales Studium)</p>
          <p class="text-xs font-mono text-red mb-2">Oktober 2024 – heute</p>
          <ul class="text-xs text-cream/50 space-y-1">
            <li>› Softwareentwicklung im professionellen Umfeld</li>
            <li>› Praktische Anwendung von Studieninhalten</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="reveal reveal-delay-3 md:col-span-2">
      <h3 class="text-xs font-mono tracking-widest text-cream/40 uppercase mb-6 pb-3 border-b border-cream/10">
        Zertifikate & Weiterbildung
      </h3>
      <ul>
        {roadmap.map((item) => (
          <li class={`flex items-baseline gap-4 py-3 border-b border-cream/5 transition-colors ${
            item.status === 'ACTIVE' ? 'border-l-2 border-l-red/40 pl-3' : ''
          }`}>
            <span class={`font-mono text-xs tracking-widest shrink-0 ${
              item.status === 'ACTIVE' ? 'text-red' :
              item.status === 'NEXT'   ? 'text-cream/60' :
              item.status === 'DONE'   ? 'text-cream/30' :
                                         'text-cream/20'
            }`}>
              [{item.status}]
            </span>
            <span class={`font-mono text-xs flex-1 min-w-0 ${
              item.status === 'ACTIVE' ? 'text-cream' :
              item.status === 'NEXT'   ? 'text-cream/70' :
              item.status === 'DONE'   ? 'text-cream/40' :
                                         'text-cream/20'
            }`}>
              {item.label}
            </span>
            <span class={`font-mono text-xs hidden sm:block ${
              item.status === 'ACTIVE' ? 'text-red/60' :
              item.status === 'NEXT'   ? 'text-cream/30' :
              item.status === 'DONE'   ? 'text-cream/20' :
                                         'text-cream/10'
            }`}>
              {item.sub}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
